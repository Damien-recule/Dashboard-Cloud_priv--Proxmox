# Exemple .env - NebTech Cloud Dashboard sécurisé

APP_ENV=production
LOG_LEVEL=INFO
APP_PORT=443
SSL_CERT=dashboard.pem
SSL_KEY=dashboard.key

FLASK_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
SESSION_LIFETIME_SECONDS=3600

ADMIN_USERNAME=USER_DASHBOARD
# Générer avec :
# python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('TON_MDP_FORT'))"
ADMIN_PASSWORD_HASH=CHANGE_ME_HASH

# Générer avec :
# python3 -c "import pyotp; print(pyotp.random_base32())"
TOTP_SECRET=CHANGE_ME_TOTP_SECRET

PVE_TOKEN_ID=root@pam!dashboard
PVE_SECRET=fb8526cd-32fd-4213-9461-227467b3c08e
PVE_VERIFY_TLS=true
# PVE_CA_BUNDLE=/etc/ssl/certs/proxmox-ca.pem

PVE_001_IP=
PVE_002_IP=
PVE_003_IP=
PVE_SSH_USER=svc-proxmox

ANSIBLE_HOST=
ANSIBLE_SSH_USER=svc-ansible
ANSIBLE_TARGET_USER=root
ANSIBLE_TARGET_PASSWORD=CHANGE_ME_TEMPORAIRE

TERRAFORM_HOST=
TERRAFORM_ENDPOINT=https://IP:8006
TERRAFORM_PROVIDER_VERSION=0.87.0
TERRAFORM_PVE_USERNAME=root@pam
TERRAFORM_PVE_PASSWORD=
TERRAFORM_DATASTORE=Shared-NFS

JENKINS_HOST=
GRAYLOG_HOST=
KUBERNETES_HOST=

CLI_SSH_USER=svc-vm
CLI_SSH_PASSWORD=CHANGE_ME
SOCKETIO_CORS_ORIGINS=*
GROUPS_FILE=/etc/terraform/cloud-project/environments/production/groups.json
